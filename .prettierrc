{
  "printWidth": 110,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": ["*.md", "*.yml", "*.yaml"], "options": { "printWidth": 100, "proseWrap": "preserve" } }
  ]
}
