---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

// Slow-scrolling strip of product names between the hero and the catalogue.
const names = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data.name);
const items = [...names, 'Delivery all over India', '100% Vegetarian', 'FSSAI licensed'];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[0, 1].map(() => (
      <ul>
        {items.map((t) => (
          <li>
            <Icon name="spark" size={12} /> {t}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    background: var(--maroon);
    color: var(--gold-light);
    border-block: 3px solid var(--gold);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 40s linear infinite;
  }
  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }
  .ticker ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  .ticker li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 28px;
    white-space: nowrap;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
  }
  .ticker li :global(svg) {
    color: var(--gold);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
