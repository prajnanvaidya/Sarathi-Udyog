---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { whatsappLink, callLink, formatPrice, productImage } from '../lib/site';

interface Props {
  product: CollectionEntry<'products'>;
  index: number;
}
const { product, index } = Astro.props;
const p = product.data;
const img = productImage(p.image);
const slug = product.id;
const hasDetails = p.ingredients || p.allergens || p.shelfLife || p.storage;
const full = await getImage({ src: img, width: 1200, format: 'webp' });
---

<article
  class="product reveal"
  id={`product-${slug}`}
  data-category={p.category}
  style={`--delay: ${(index % 4) * 70}ms`}
  aria-labelledby={`${slug}-title`}
>
  <button
    class="product-media"
    type="button"
    data-lightbox
    data-full={full.src}
    data-alt={p.name}
    aria-label={`View larger photo of ${p.name}`}
  >
    <Image class="backdrop" src={img} alt="" width={80} aria-hidden="true" loading="lazy" decoding="async" />
    <Image
      class="photo"
      src={img}
      alt={p.name}
      width={640}
      widths={[320, 480, 640, 960]}
      sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 280px"
      loading={index < 2 ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="zoom" aria-hidden="true"><Icon name="zoom" size={18} /></span>
    {!p.available && <span class="soldout">Currently unavailable</span>}
  </button>

  <div class="product-body">
    <div class="product-chips">
      {p.badges.slice(0, 3).map((b, i) => <span class={`chip ${i === 0 ? '' : 'chip-gold'}`}>{b}</span>)}
    </div>
    <h3 id={`${slug}-title`}>{p.name}</h3>
    {p.tagline && <p class="tagline">{p.tagline}</p>}
    {p.description && <p class="desc">{p.description}</p>}

    <div class="price-row">
      {p.price != null ? (
        <>
          <span class="price">{formatPrice(p.price)}</span>
          {p.unit && <span class="unit">/ {p.unit}</span>}
        </>
      ) : (
        <span class="ask">Ask for price</span>
      )}
      {p.priceNote && <span class="note">{p.priceNote}</span>}
    </div>

    {hasDetails && (
      <details class="details">
        <summary>Ingredients &amp; storage <Icon name="chevron" size={16} /></summary>
        <dl>
          {p.ingredients && <><dt>Ingredients</dt><dd>{p.ingredients}</dd></>}
          {p.allergens && <><dt>Allergens</dt><dd>{p.allergens}</dd></>}
          {p.shelfLife && <><dt>Shelf life</dt><dd>{p.shelfLife}</dd></>}
          {p.storage && <><dt>Storage</dt><dd>{p.storage}</dd></>}
        </dl>
      </details>
    )}

    <div class="actions">
      <a class="btn btn-wa btn-sm" href={whatsappLink(p.name)} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" /> Order on WhatsApp
      </a>
      <a class="btn btn-outline btn-sm" href={callLink} aria-label={`Call to order ${p.name}`}>
        <Icon name="phone" /><span class="sr-only">Call</span>
      </a>
    </div>
  </div>
</article>

<style>
  .product {
    display: flex; flex-direction: column;
    background: #fff; border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform .35s var(--ease), box-shadow .35s var(--ease), opacity .7s var(--ease);
  }
  .product:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .product.hidden { display: none; }

  /* Image frame: blurred copy of the same photo fills the box so any aspect ratio looks intentional */
  .product-media {
    position: relative; display: block; width: 100%; aspect-ratio: 4 / 4.4;
    padding: 0; border: 0; background: var(--cream-2); cursor: zoom-in; overflow: hidden;
    isolation: isolate;
  }
  .product-media .backdrop {
    position: absolute; inset: -10%; width: 120%; height: 120%; object-fit: cover;
    filter: blur(28px) saturate(1.3); opacity: .55; z-index: 0;
  }
  .product-media .photo {
    position: relative; z-index: 1; width: 100%; height: 100%; object-fit: contain;
    padding: 14px; transition: transform .5s var(--ease);
  }
  .product:hover .photo { transform: scale(1.04); }
  .zoom {
    position: absolute; right: 12px; bottom: 12px; z-index: 2;
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    background: rgba(255,255,255,.9); color: var(--maroon); box-shadow: var(--shadow-sm);
    opacity: 0; transform: translateY(6px); transition: opacity .25s, transform .25s var(--ease);
  }
  .product:hover .zoom, .product-media:focus-visible .zoom { opacity: 1; transform: none; }
  .soldout {
    position: absolute; left: 12px; top: 12px; z-index: 2;
    padding: 6px 10px; border-radius: 999px; background: var(--maroon); color: #fff;
    font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
  }

  .product-body { display: flex; flex-direction: column; flex: 1; padding: 18px 20px 20px; gap: 8px; }
  .product-chips { display: flex; flex-wrap: wrap; gap: 6px; min-height: 22px; }
  .product h3 { font-size: 1.3rem; margin-top: 4px; }
  .tagline { font-family: var(--font-display); font-style: italic; color: var(--red-bright); font-size: .98rem; }
  .desc { color: var(--ink-soft); font-size: .93rem; }

  .price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 8px; margin-top: 6px; }
  .price { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; color: var(--maroon); line-height: 1; }
  .unit { color: var(--ink-mute); font-size: .9rem; font-weight: 500; }
  .ask { font-weight: 700; color: var(--green); font-size: 1.05rem; }
  .note { flex-basis: 100%; font-size: .8rem; color: var(--ink-mute); }

  .details { border-top: 1px dashed var(--line); margin-top: 6px; padding-top: 8px; font-size: .88rem; }
  .details summary {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    cursor: pointer; list-style: none; font-weight: 600; color: var(--maroon); padding: 4px 0;
  }
  .details summary::-webkit-details-marker { display: none; }
  .details summary :global(svg) { transition: rotate .25s var(--ease); }
  .details[open] summary :global(svg) { rotate: 180deg; }
  .details dl { margin: 6px 0 0; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; color: var(--ink-soft); }
  .details dt { font-weight: 700; color: var(--ink); }
  .details dd { margin: 0; }

  .actions { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: auto; padding-top: 12px; }
  .actions .btn-wa { min-width: 0; padding-inline: 12px; font-size: .88rem; }
  .actions .btn-outline { width: 44px; padding: 0; }
</style>
