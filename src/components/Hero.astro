---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site, whatsappLink, callLink, productImage } from '../lib/site';

// Three hero images from the catalogue; swap file names here to feature others.
const collage = [
  {
    img: productImage('mixed-mango-pickle.jpg'),
    alt: 'Mixed mango, lemon and karande kai pickle jar',
    cls: 'c1',
  },
  { img: productImage('cashew-biscuits.jpg'), alt: 'Cashew biscuits pack', cls: 'c2' },
  { img: productImage('premium-red-chilly-powder.jpg'), alt: 'Homemade red chilly powder', cls: 'c3' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal">A taste of tradition, from Udupi</p>
      <h1 id="hero-title" class="reveal" style="--delay: 80ms">
        Traditional Taste,
        <br />
        <em>Timeless</em> Delight
      </h1>
      <p class="lead reveal" style="--delay: 160ms">
        Cashew biscuits, nankhatai, eggless cakes, oil-free mango pickles and homemade spices — made in small
        batches the way Karnataka homes have always made them. 100% vegetarian.
      </p>
      <div class="hero-actions reveal" style="--delay: 240ms">
        <a class="btn btn-wa" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> Order on WhatsApp
        </a>
        <a class="btn btn-outline" href="#products">
          See our products <Icon name="arrow" />
        </a>
      </div>
      <ul class="hero-proof reveal" style="--delay: 320ms" aria-label="Highlights">
        <li>
          <Icon name="leaf" /> 100% Veg
        </li>
        <li>
          <Icon name="home" /> Small-batch &amp; homemade
        </li>
        <li>
          <Icon name="truck" /> Ships across India
        </li>
      </ul>
    </div>

    <div class="hero-art">
      {collage.map((c, i) => (
        <figure class={`card ${c.cls} reveal`} style={`--delay: ${200 + i * 120}ms`}>
          <Image src={c.img} alt={c.alt} width={520} loading="eager" sizes="(max-width: 700px) 60vw, 340px" />
        </figure>
      ))}
      <span class="stamp" aria-hidden="true">
        <Icon name="star" size={14} /> Made in Udupi
      </span>
    </div>
  </div>
  <p class="hero-phone-wrap">
    <a class="hero-phone" href={callLink}>
      <Icon name="phone" size={16} /> Prefer to call? {site.callNumber.replace(/^91/, '+91 ')}
    </a>
  </p>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px);
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 55% at 85% 20%, rgba(253, 216, 53, 0.55), transparent 70%),
      radial-gradient(45% 45% at 10% 90%, rgba(230, 180, 34, 0.28), transparent 70%),
      linear-gradient(180deg, #fff6d8 0%, var(--cream) 100%);
  }
  /* subtle rangoli dot grid */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(122, 10, 14, 0.1) 1px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.6), transparent 80%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.6), transparent 80%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }
  .hero-copy h1 {
    margin-top: 18px;
  }
  .hero-copy h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--red-bright);
    font-variation-settings:
      'opsz' 144,
      'SOFT' 100,
      'WONK' 1;
  }
  .lead {
    margin-top: 22px;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 54ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .hero-proof {
    list-style: none;
    padding: 0;
    margin: 34px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .hero-proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-proof :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--green);
  }

  /* Collage ---------------------------------------------------------------- */
  .hero-art {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 520px;
    margin-inline: auto;
    width: 100%;
  }
  .hero-art .card {
    position: absolute;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    padding: 8px;
    box-shadow:
      var(--shadow-lg),
      0 0 0 1px rgba(122, 10, 14, 0.06);
    animation: float 7s ease-in-out infinite;
  }
  .hero-art .card img {
    border-radius: calc(var(--radius) - 8px);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .c1 {
    left: 4%;
    top: 6%;
    width: 52%;
    aspect-ratio: 3 / 4;
    z-index: 2;
    --rot: -4deg;
  }
  .c2 {
    right: 0;
    top: 0;
    width: 44%;
    aspect-ratio: 4 / 5;
    z-index: 1;
    --rot: 5deg;
    animation-delay: -2.4s;
  }
  .c3 {
    right: 8%;
    bottom: 0;
    width: 46%;
    aspect-ratio: 1;
    z-index: 3;
    --rot: 3deg;
    animation-delay: -4.8s;
  }
  .hero-art .card.reveal {
    transform: translateY(22px) rotate(var(--rot));
  }
  .hero-art .card.reveal.in {
    transform: rotate(var(--rot));
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }
  .stamp {
    position: absolute;
    left: 2%;
    bottom: 10%;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 999px;
    background: var(--maroon);
    color: var(--gold-light);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    box-shadow: var(--shadow);
    rotate: -6deg;
  }

  .hero-phone-wrap {
    text-align: center;
    margin-top: 36px;
  }
  .hero-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px dashed var(--gold);
    background: rgba(255, 255, 255, 0.5);
  }
  .hero-phone:hover {
    color: var(--maroon);
    background: #fff;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      text-align: center;
    }
    .lead {
      margin-inline: auto;
    }
    .hero-actions,
    .hero-proof {
      justify-content: center;
    }
    .hero-art {
      max-width: 440px;
      margin-top: 12px;
    }
  }
  @media (max-width: 480px) {
    .hero-actions .btn {
      width: 100%;
    }
    .hero-art {
      aspect-ratio: 1 / 1.05;
    }
  }
</style>
