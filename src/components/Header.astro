---
import { Image } from 'astro:assets';
import emblem from '../assets/logo-emblem.png';
import Icon from './Icon.astro';
import { site, whatsappLink } from '../lib/site';

const links = [
  { href: '#products', label: 'Products' },
  { href: '#order', label: 'How to order' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<div class="topbar">
  <div class="wrap topbar-inner">
    <span>
      <Icon name="leaf" size={14} /> 100% Vegetarian
    </span>
    <span class="dot" aria-hidden="true">
      •
    </span>
    <span>
      <Icon name="shield" size={14} /> FSSAI Lic. {site.fssai}
    </span>
    <span class="dot" aria-hidden="true">
      •
    </span>
    <span>
      <Icon name="truck" size={14} /> Delivery all over India
    </span>
  </div>
</div>

<header class="site-header" id="top">
  <nav class="wrap nav" aria-label="Main">
    <a class="brand" href="#top" aria-label={`${site.name} — home`}>
      <Image src={emblem} alt="" width={112} densities={[1, 2]} loading="eager" class="brand-logo" />
      <span class="brand-text">
        <span class="brand-name">Sarathi Udyog</span>
        <span class="brand-tag">Udupi, Karnataka</span>
      </span>
    </a>

    <div class="nav-links" id="nav-links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
      <a class="btn btn-wa btn-sm nav-cta" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" /> Order on WhatsApp
      </a>
    </div>

    <div class="nav-actions">
      {/* Shows the current theme's icon; the label names the action. The script keeps both in sync. */}
      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        title="Switch to dark theme"
      >
        <Icon name="sun" class="i-sun" />
        <Icon name="moon" class="i-moon" />
      </button>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </nav>
</header>

<style>
  .topbar {
    background: var(--maroon);
    color: var(--gold-light);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-block: 7px;
    flex-wrap: wrap;
  }
  .topbar span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .topbar .dot {
    opacity: 0.5;
  }
  @media (max-width: 560px) {
    .topbar span:nth-child(2),
    .topbar span:nth-child(3) {
      display: none;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(var(--cream-rgb), 0.86);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.3s var(--ease);
  }
  .site-header.scrolled {
    box-shadow: 0 8px 30px -12px rgba(var(--shadow-rgb), 0.25);
  }
  /* Compact the brand with a transform only. Changing the header's real height on scroll
     makes Chrome's scroll anchoring shift scrollY, which re-toggles the class — a flicker loop. */
  .site-header.scrolled .brand {
    transform: scale(0.9);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    transform-origin: left center;
    transition: transform 0.3s var(--ease);
  }
  .brand-logo {
    width: auto;
    height: 52px;
    filter: drop-shadow(0 1px 1px rgba(122, 10, 14, 0.25));
    transition: transform 0.3s var(--ease);
  }
  .brand:hover .brand-logo {
    transform: scale(1.04);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--heading);
    letter-spacing: 0.01em;
  }
  .brand-tag {
    font-size: 0.72rem;
    color: var(--ink-mute);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto; /* keeps links + CTA on the right, next to the theme toggle */
  }
  .nav-links > a:not(.btn) {
    position: relative;
    padding: 10px 14px;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .nav-links > a:not(.btn):hover {
    background: var(--cream-2);
    color: var(--heading);
  }
  .nav-cta {
    margin-left: 10px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--heading);
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s var(--ease);
  }
  .theme-toggle:hover {
    border-color: var(--gold);
    background: var(--cream-2);
    transform: translateY(-1px);
  }
  .theme-toggle :global(svg) {
    width: 20px;
    height: 20px;
  }
  .theme-toggle :global(.i-moon) {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle :global(.i-sun) {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle :global(.i-moon) {
    display: block;
  }

  .nav-toggle {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: pointer;
    place-items: center;
    color: var(--heading);
  }
  .nav-toggle :global(.i-close) {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] :global(.i-open) {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] :global(.i-close) {
    display: block;
  }

  @media (max-width: 860px) {
    .nav {
      gap: 12px;
    }
    .nav-actions {
      gap: 6px;
    }
    /* Square it off to match the menu button beside it; 44px keeps a comfortable tap target. */
    .theme-toggle {
      width: 44px;
      height: 44px;
      border-radius: 12px;
    }
    .nav-toggle {
      display: grid;
    }
    .nav-links {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 12px var(--gutter) 18px;
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 20px 40px -20px rgba(var(--shadow-rgb), 0.35);
      transform-origin: top;
      transform: scaleY(0.95);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.25s var(--ease),
        transform 0.25s var(--ease),
        visibility 0s 0.25s;
    }
    .nav-links.open {
      opacity: 1;
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }
    .nav-links > a:not(.btn) {
      padding: 12px 14px;
      font-size: 1.05rem;
    }
    .nav-cta {
      margin: 10px 0 0;
      justify-content: center;
    }
    .brand-logo {
      height: 44px;
    }
    .brand-name {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('nav-links');

  // Hysteresis: turn on past 40px, off only below 8px, so the state can't oscillate
  // when the scroll position sits right at a threshold.
  let scrolled = false;
  const onScroll = () => {
    const y = window.scrollY;
    const next = scrolled ? y > 8 : y > 40;
    if (next !== scrolled) {
      scrolled = next;
      header?.classList.toggle('scrolled', scrolled);
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  if (toggle && links) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      links.classList.toggle('open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    links.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  // Theme toggle. src/scripts/theme-init.js has already set data-theme before first paint;
  // this flips it, remembers the choice, and follows the OS only until the user has chosen.
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (themeBtn) {
    const root = document.documentElement;
    const savedTheme = () => {
      try {
        return localStorage.getItem('theme');
      } catch {
        return null;
      }
    };
    const apply = (theme: 'light' | 'dark') => {
      root.dataset.theme = theme;
      const text = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
      themeBtn.setAttribute('aria-label', text);
      themeBtn.title = text;
    };
    themeBtn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked: the choice still applies for this page */
      }
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      const saved = savedTheme();
      if (saved !== 'light' && saved !== 'dark') apply(e.matches ? 'dark' : 'light');
    });
    apply(root.dataset.theme === 'dark' ? 'dark' : 'light'); // sync the label with the init script
  }
</script>
