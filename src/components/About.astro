---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo.jpg';
import { site, productImage } from '../lib/site';

const gallery = [
  productImage('nankhatai.jpg'),
  productImage('midi-mango-pickle.jpg'),
  productImage('premium-dry-fruits.jpg'),
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about-grid">
    <div class="about-art reveal">
      <div class="logo-card">
        <Image src={logo} alt={`${site.name} logo`} width={520} loading="lazy" />
      </div>
      <div class="mini-gallery" aria-hidden="true">
        {gallery.map((g, i) => (
          <Image src={g} alt="" width={260} height={260} fit="cover" loading="lazy" style={`--i: ${i}`} />
        ))}
      </div>
    </div>

    <div class="about-copy">
      <p class="eyebrow reveal">About Sarathi Udyog</p>
      <h2 id="about-title" class="reveal" style="--delay: 60ms">Recipes people remember, from a home in Udupi</h2>
      <div class="reveal" style="--delay: 140ms">
        <p>
          Sarathi Udyog is a small family food business from Anjar village in Udupi district, on the
          Karnataka coast. We bake crisp cashew biscuits and cardamom nankhatai, make oil-free mango
          pickles the way they have always been made in coastal homes, grind our own red chilly
          powder, and source premium cashews and dry fruits from the region.
        </p>
        <p>
          Everything is prepared in small batches with familiar ingredients — no shortcuts, no
          artificial colours. It is food we serve at our own table, and we are happy to send it to yours.
        </p>
      </div>
      <ul class="founders reveal" style="--delay: 220ms">
        {site.proprietors.map((name) => (
          <li><Icon name="star" size={14} /> {name}</li>
        ))}
        <li class="muted">Proprietors</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about { background: linear-gradient(180deg, #fff 0, var(--cream-2) 100%); overflow: hidden; }
  .about-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .about-copy h2 { margin-top: 14px; }
  .about-copy p { margin-top: 18px; color: var(--ink-soft); font-size: 1.04rem; }
  .founders { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .founders li {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line);
    font-weight: 600; font-size: .92rem; color: var(--maroon);
  }
  .founders li :global(svg) { color: var(--gold); }
  .founders li.muted { background: transparent; border: 0; color: var(--ink-mute); font-weight: 500; padding-left: 0; }

  .about-art { position: relative; }
  .logo-card {
    background: #fff; padding: 12px; border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg); border: 1px solid var(--line);
    rotate: -2deg; transition: rotate .4s var(--ease);
  }
  .about-art:hover .logo-card { rotate: 0deg; }
  .logo-card img { border-radius: calc(var(--radius-lg) - 12px); width: 100%; }
  .mini-gallery {
    display: flex; gap: 12px; margin-top: -30px; margin-left: 8%;
  }
  .mini-gallery img {
    width: 30%; aspect-ratio: 1; object-fit: cover; border-radius: 16px;
    border: 4px solid #fff; box-shadow: var(--shadow);
    transform: translateY(calc(var(--i) * 10px)) rotate(calc((var(--i) - 1) * 3deg));
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-art { max-width: 460px; margin: 0 auto 28px; }
  }
</style>
