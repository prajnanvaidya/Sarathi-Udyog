---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo.png';
import { site, productImage } from '../lib/site';

const gallery = [
  productImage('nankhatai.jpg'),
  productImage('midi-mango-pickle.jpg'),
  productImage('premium-dry-fruits.jpg'),
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about-grid">
    <div class="about-art reveal">
      <div class="logo-card">
        <Image src={logo} alt={`${site.name} logo`} width={520} loading="lazy" />
      </div>
      <div class="mini-gallery" aria-hidden="true">
        {gallery.map((g, i) => (
          <Image src={g} alt="" width={260} height={260} fit="cover" loading="lazy" style={`--i: ${i}`} />
        ))}
      </div>
    </div>

    <div class="about-copy">
      <p class="eyebrow reveal">About Sarathi Udyog</p>
      <h2 id="about-title" class="reveal" style="--delay: 60ms">
        From our family in Udupi, to your home
      </h2>
      <div class="reveal" style="--delay: 140ms">
        <p class="about-lead">
          Sarathi Udyog is a <em>family-started venture</em>, bringing quality sweets, pickles &amp; dry
          fruits to your home.
        </p>
        <p>
          Every product is chosen with care and carefully repacked with hygiene and love, so it reaches you
          fresh and delicious: crisp cashew biscuits and cardamom nankhatai, soft eggless cake, oil-free mango
          pickles the way coastal homes have always made them, homemade red chilly powder, and premium cashews
          and dry fruits.
        </p>
        <p>
          We started at home, and home is still our standard — sealed packs, clear labels with our FSSAI
          licence number, and only what we would gladly serve at our own table. Wherever you are in India, we
          are happy to send it to yours.
        </p>
      </div>
      <ul class="founders reveal" style="--delay: 220ms">
        {site.proprietors.map((name) => (
          <li>
            <Icon name="star" size={14} /> {name}
          </li>
        ))}
        <li class="muted">Proprietors</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: linear-gradient(180deg, var(--bg-alt) 0, var(--cream-2) 100%);
    overflow: hidden;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .about-copy h2 {
    margin-top: 14px;
  }
  .about-copy p {
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 1.04rem;
  }
  /* Opening line set apart as a pull-quote: display face, maroon, gold rule. */
  .about-copy .about-lead {
    margin-top: 22px;
    padding-left: 18px;
    border-left: 3px solid var(--gold);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--heading);
  }
  .about-lead em {
    font-style: italic;
    color: var(--red-bright);
  }
  .founders {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .founders li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--heading);
  }
  .founders li :global(svg) {
    color: var(--gold);
  }
  .founders li.muted {
    background: transparent;
    border: 0;
    color: var(--ink-mute);
    font-weight: 500;
    padding-left: 0;
  }

  .about-art {
    position: relative;
  }
  .logo-card {
    background: linear-gradient(160deg, #ffe45c, var(--yellow) 60%, #f5c400);
    padding: 30px 28px 26px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
    rotate: -2deg;
    transition: rotate 0.4s var(--ease);
  }
  .about-art:hover .logo-card {
    rotate: 0deg;
  }
  .logo-card img {
    width: 100%;
    filter: drop-shadow(0 6px 10px rgba(122, 10, 14, 0.25));
  }
  .mini-gallery {
    display: flex;
    gap: 12px;
    margin-top: -30px;
    margin-left: 8%;
  }
  .mini-gallery img {
    width: 30%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
    border: 4px solid var(--frame);
    box-shadow: var(--shadow);
    transform: translateY(calc(var(--i) * 10px)) rotate(calc((var(--i) - 1) * 3deg));
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-art {
      max-width: 460px;
      margin: 0 auto 28px;
    }
  }
</style>
