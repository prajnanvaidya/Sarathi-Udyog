# Security headers — read automatically by Cloudflare Pages and Netlify.
# The site has no forms, no third-party scripts and no cookies, so the policy can be strict:
#   script-src 'self'      every script is a hashed file under /_astro/ (nothing inline)
#   style-src 'unsafe-inline' is needed only for the small `style="--delay: …"` attributes
#   img-src 'self' data:   product photos are same-origin; data: allows the inline SVG favicon
/*
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# Hashed build assets never change: cache for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and the link-preview image change rarely
/favicon*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-image.jpg
  Cache-Control: public, max-age=604800
